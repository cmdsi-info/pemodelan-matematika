\begin_layout Section
Pertumbuhan populasi tanpa batas
\end_layout

\begin_layout Itemize
Populasi 
\begin_inset Formula $N\left(t\right)$
\end_inset

 bertambah seiring waktu 
\begin_inset Formula $t$
\end_inset

 dengan laju 
\begin_inset Formula $r$
\end_inset

 yang sebanding dengan ukuran populasi itu sendiri.
\begin_inset Formula 
\[
\frac{dN\left(t\right)}{dt}=rN\left(t\right)
\]

\end_inset


\end_layout

\begin_layout Itemize
model tersebut kurang realistis,
 karena populasi akan bertambah secara terus menerus seiring bertambahnya waktu.
 karena pada kenyataannya,
 populasi akan berhenti bertambah karena adanya keterbatasan makanan,
 tempat,
 dan keterbatasan yang lainnya.
\end_layout

\begin_layout Itemize
Apabila populasi bertambah secara terus menerus maka akan kontradiksi dengan kondisi nyata.
 karena sumberdaya terbatas dan tidak mungkin mendukung pertumbuhan secara terus menerus tanpa akhir.
\end_layout

\begin_layout Itemize
Oleh sebab itu Pierre Francois Valhutt memperkenalkan model logistik.
 model ini menambahkan kapasitas dukung lingkungan 
\begin_inset Formula $K$
\end_inset

,
 sehingga model pertumbuhan populasi diatas direvisi menjadi
\begin_inset Formula 
\[
\frac{dN}{dt}=rN\left(1-\frac{N}{K}\right)
\]

\end_inset

dengan 
\begin_inset Formula $r$
\end_inset

 laju pertumbuhan intrinsik,
 dan 
\begin_inset Formula $K$
\end_inset

 kapasitas maksimum populasi yang dapat ditopang oleh lingkungan.
\end_layout

\begin_layout Itemize
Solusi dari model tersebut
\begin_inset Formula 
\begin{align*}
\frac{dN}{dt} & =rN\left(\frac{K-N}{K}\right)\\
\frac{K}{N\left(K-N\right)}dN & =rdt\\
\left(\frac{1}{N}+\frac{1}{K-N}\right)dN & =rdt\\
\int\left(\frac{1}{N}+\frac{1}{K-N}\right)dN & =\int rdt\\
\log\left(N\right)-\log\left(K-N\right) & =rt+C\\
\log\left(\frac{N}{K-N}\right) & =rt+C\\
\frac{N}{K-N} & =e^{rt+C}\\
N & =Ce^{rt}\left(K-N\right)\\
N & =CKe^{rt}-Ce^{rt}N\\
\end{align*}

\end_inset


\begin_inset Formula 
\begin{align*}
N+Ce^{rt}N & =CKe^{rt}\\
\left(1-Ce^{rt}\right)N & =CKe^{rt}\\
N & =\frac{CKe^{rt}}{1-Ce^{rt}}
\end{align*}

\end_inset


\end_layout

\begin_layout Itemize
Misalkan
\begin_inset Formula 
\[
y=ae^{bx}
\]

\end_inset


\begin_inset Formula 
\begin{align*}
\log\left(y\right) & =\log\left(a\right)+\log\left(e^{bx}\right)\\
\log\left(y\right) & =\log\left(a\right)+bx\\
 & =b_{0}+b_{1}x
\end{align*}

\end_inset

misalkan 
\begin_inset Formula $\log\left(y\right)=z$
\end_inset

,
 maka diperoleh
\begin_inset Formula 
\[
z=b_{0}+b_{1}x
\]

\end_inset


\end_layout

